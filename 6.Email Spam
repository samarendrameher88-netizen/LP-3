import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.svm import SVC
from sklearn.metrics import accuracy_score, classification_report

df = pd.read_csv(r"C:\Users\samar\OneDrive\Desktop\practical\LP3\emails.csv")

X = df[['the', 'to', 'win', 'offer']]   
Y = df['Prediction']                    

X_train, X_test, Y_train, Y_test = train_test_split(
    X, Y, test_size=0.25, random_state=42
)

# KNN
knn = KNeighborsClassifier(n_neighbors=7)
knn.fit(X_train, Y_train)
p1 = knn.predict(X_test)

print("KNN Accuracy:", accuracy_score(Y_test, p1))
print(classification_report(Y_test, p1))

# SVM
svm = SVC()
svm.fit(X_train, Y_train)
p2 = svm.predict(X_test)

print("SVM Accuracy:", accuracy_score(Y_test, p2))
print(classification_report(Y_test, p2))
