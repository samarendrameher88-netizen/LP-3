import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import accuracy_score

data = pd.read_csv(r"C:\Users\samar\OneDrive\Desktop\practical\LP3\bank.csv")
# data.head()
# data.describe()
X = data[['CreditScore', 'Age', 'Balance', 'EstimatedSalary']]
y = data['Exited']

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

model = MLPClassifier(max_iter=500)
model.fit(X_train, y_train)

y_pred = model.predict(X_test)

print("Accuracy:", accuracy_score(y_test, y_pred))

# Simple Explanation
# 1. read_csv() – Loads the bank dataset.
# 2. X – Contains customer information (input).
# 3. y – Contains the result (0 = Stay, 1 = Leave).
# 4. train_test_split() – Splits data into training and testing.
# 5. MLPClassifier() – Creates a neural network.
# 6. fit() – Trains the neural network.
# 7. predict() – Predicts whether customers will leave or stay.
# 8. accuracy_score() – Calculates prediction accuracy.
# Important
# - 0 = Customer will stay.
# - 1 = Customer will leave.
# - MLPClassifier is a neural network algorithm.
